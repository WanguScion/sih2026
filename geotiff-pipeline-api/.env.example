# HTTP server port
PORT=3000

# Directory where uploaded files are saved as survey.tif and dsm.tif
INPUT_PATH=./data/input

# Where the pipeline's 3D vector GeoJSON result is read from.
# Can be a direct .geojson file path, or a directory the pipeline writes
# a .geojson file into (both are supported).
OUTPUT_PATH=./data/output/roofs_3d.geojson

# Path to the Python pipeline entry point (e.g. main.py from the
# geotiff_segformer_gis project)
MAIN_PIPELINE_PATH=../geotiff_segformer_gis/main.py

# Python executable to invoke MAIN_PIPELINE_PATH with
PYTHON_EXECUTABLE=python3

# How long to wait for the pipeline process before killing it (ms)
PIPELINE_TIMEOUT_MS=600000

# Max accepted size per uploaded file, in MB
MAX_UPLOAD_MB=500

# Temp directory uploads are first written to, before being moved to
# INPUT_PATH/survey.tif and INPUT_PATH/dsm.tif. Defaults to a folder
# under the OS temp dir if not set.
# UPLOAD_TMP_DIR=./data/tmp-uploads

# PostgreSQL + PostGIS connection string (used by Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/geotiff_pipeline

# Allowed origin for browser requests (CORS). "*" allows any origin -
# fine for local development, but set this to your actual frontend's
# origin (e.g. https://app.example.com) in production.
CORS_ORIGIN=*
